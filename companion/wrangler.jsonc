// Cloudflare Workers — static assets only (no Worker script).
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "airglove-companion",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    // SPA mode: serve /index.html for any path that doesn't match a static file,
    // so client-side routing works and deep links don't 404.
    "not_found_handling": "single-page-application"
  }
}
